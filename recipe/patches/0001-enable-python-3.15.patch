From 947d9ce0c76ffeb319e24bf69477fe33025cbe64 Mon Sep 17 00:00:00 2001
From: Serhii Kupriienko <skupriienko@anaconda.com>
Date: Thu, 20 Aug 2026 15:43:32 +0000
Subject: [PATCH] Enable CPython 3.15 in Numba 0.66.0

Lift setup.py and C version guards, and compile C++ with /std:c++20 on MSVC
so pycore_backoff.h (CPython 3.15) accepts designated initializers.

Co-authored-by: Cursor <cursoragent@cursor.com>
---
 numba/_dispatcher.cpp |  4 ++--
 numba/_dynfunc.c      |  2 +-
 numba/_helperlib.c    |  4 ++--
 numba/_pymodule.h     |  2 +-
 numba/_typeof.cpp     |  2 +-
 setup.py              | 20 +++++++++++++-------
 6 files changed, 20 insertions(+), 14 deletions(-)

diff --git a/numba/_dispatcher.cpp b/numba/_dispatcher.cpp
index ad74b87..2eeda49 100644
--- a/numba/_dispatcher.cpp
+++ b/numba/_dispatcher.cpp
@@ -27,7 +27,7 @@
  *
  */
 
-#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14))
+#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14) || (PY_MINOR_VERSION == 15))
 
 #ifndef Py_BUILD_CORE
     #define Py_BUILD_CORE 1
@@ -1644,7 +1644,7 @@ static PyTypeObject DispatcherType = {
 };
 
 
-#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14))
+#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14) || (PY_MINOR_VERSION == 15))
 static
 bool is_sysmon_enabled(Dispatcher * self) {
     return self->enable_sysmon;
diff --git a/numba/_dynfunc.c b/numba/_dynfunc.c
index d2722d5..3922cb0 100644
--- a/numba/_dynfunc.c
+++ b/numba/_dynfunc.c
@@ -9,7 +9,7 @@
 
 
 // if python version is 3.13
-#if ((PY_MAJOR_VERSION == 3) && ((PY_MINOR_VERSION == 13) || PY_MINOR_VERSION == 14))
+#if ((PY_MAJOR_VERSION == 3) && ((PY_MINOR_VERSION == 13) || PY_MINOR_VERSION == 14 || PY_MINOR_VERSION == 15))
     #include "pythoncapi_compat.h"
     #define _Py_IsFinalizing Py_IsFinalizing
 #endif
diff --git a/numba/_helperlib.c b/numba/_helperlib.c
index 14d57ca..1172be7 100644
--- a/numba/_helperlib.c
+++ b/numba/_helperlib.c
@@ -839,7 +839,7 @@ static void traceback_add(const char *funcname, const char *filename, int lineno
     if (!frame)
         goto error;
 
-#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14))
+#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14) || (PY_MINOR_VERSION == 15))
 #elif (PY_MAJOR_VERSION == 3) && (PY_MINOR_VERSION == 11) /* 3.11 */
 
     /* unsafe cast to our copy of _frame to access the f_lineno field */
@@ -857,7 +857,7 @@ static void traceback_add(const char *funcname, const char *filename, int lineno
     Py_DECREF(frame);
     return;
 
-#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14))
+#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14) || (PY_MINOR_VERSION == 15))
 error:
     _PyErr_ChainExceptions1(exc);
 #elif (PY_MAJOR_VERSION == 3) && ((PY_MINOR_VERSION == 10) || (PY_MINOR_VERSION == 11)) /* 3.11 and below */
diff --git a/numba/_pymodule.h b/numba/_pymodule.h
index 4de1f72..58da9cd 100644
--- a/numba/_pymodule.h
+++ b/numba/_pymodule.h
@@ -46,6 +46,6 @@
         Py_DECREF(tmp); } while (0)
 
 
-#define NB_SUPPORTED_PYTHON_MINOR ((PY_MINOR_VERSION == 10) || (PY_MINOR_VERSION == 11) || (PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14))
+#define NB_SUPPORTED_PYTHON_MINOR ((PY_MINOR_VERSION == 10) || (PY_MINOR_VERSION == 11) || (PY_MINOR_VERSION == 12) || (PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14) || (PY_MINOR_VERSION == 15))
 
 #endif /* NUMBA_PY_MODULE_H_ */
diff --git a/numba/_typeof.cpp b/numba/_typeof.cpp
index efd413f..477c374 100644
--- a/numba/_typeof.cpp
+++ b/numba/_typeof.cpp
@@ -16,7 +16,7 @@
     #include <numpy/npy_2_compat.h>
 #endif
 
-#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14))
+#if (PY_MAJOR_VERSION >= 3) && ((PY_MINOR_VERSION == 13) || (PY_MINOR_VERSION == 14) || (PY_MINOR_VERSION == 15))
     #ifndef Py_BUILD_CORE
         #define Py_BUILD_CORE 1
     #endif
diff --git a/setup.py b/setup.py
index 41fc62b..3dbd558 100644
--- a/setup.py
+++ b/setup.py
@@ -20,7 +20,8 @@ except ImportError:
 
 
 min_python_version = "3.10"
-max_python_version = "3.15"  # exclusive
+# exclusive; 0.66.0 upstream is <3.15. Lift for 3.15.0rc1 bootstrap (numba-hatchery#15).
+max_python_version = "3.16"  # exclusive
 min_numpy_build_version = "2.0.0rc1"
 min_numpy_run_version = "1.22"
 max_numpy_run_version = "2.5"
@@ -140,13 +141,19 @@ def get_ext_modules():
     np_compile_args = {'include_dirs': [np.get_include(),],}
     if sys.platform != 'win32':
         np_compile_args['libraries'] = ['m',]
+    # CPython 3.15 headers (pycore_backoff.h) need C++20 designated initializers.
+    # MSVC ignores -std=c++11 (D9002) and then fails C7555.
+    if sys.platform.startswith('win') and 'MSC' in sys.version:
+        cxx_std_flags = ['/std:c++20']
+    else:
+        cxx_std_flags = ['-std=c++11']
 
     ext_devicearray = Extension(name='numba._devicearray',
                                 sources=['numba/_devicearray.cpp'],
                                 depends=['numba/_pymodule.h',
                                          'numba/_devicearray.h'],
                                 include_dirs=['numba'],
-                                extra_compile_args=['-std=c++11'],
+                                extra_compile_args=cxx_std_flags,
                                 )
 
     ext_dynfunc = Extension(name='numba._dynfunc',
@@ -165,7 +172,7 @@ def get_ext_modules():
                                depends=["numba/_pymodule.h",
                                         "numba/_typeof.h",
                                         "numba/_hashtable.h"],
-                               extra_compile_args=['-std=c++11'],
+                               extra_compile_args=cxx_std_flags,
                                **np_compile_args)
 
     ext_helperlib = Extension(name="numba._helperlib",
@@ -190,7 +197,7 @@ def get_ext_modules():
                              sources=["numba/core/typeconv/typeconv.cpp",
                                       "numba/core/typeconv/_typeconv.cpp"],
                              depends=["numba/_pymodule.h"],
-                             extra_compile_args=['-std=c++11'],
+                             extra_compile_args=cxx_std_flags,
                              )
 
     ext_np_ufunc = Extension(name="numba.np.ufunc._internal",
@@ -242,7 +249,7 @@ def get_ext_modules():
     have_openmp = True
     if sys.platform.startswith('win'):
         if 'MSC' in sys.version:
-            cpp11flags = []
+            cpp11flags = cxx_std_flags
             ompcompileflags = ['-openmp']
             omplinkflags = []
         else:
@@ -356,9 +363,8 @@ def get_ext_modules():
                                depends=['numba/core/runtime/nrt.h',
                                         'numba/_pymodule.h',
                                         'numba/core/runtime/_nrt_python.c'],
+                               extra_compile_args=cxx_std_flags,
                                **np_compile_args)
-
-    ext_jitclass_box = Extension(name='numba.experimental.jitclass._box',
                                  sources=['numba/experimental/jitclass/_box.c'],
                                  depends=['numba/experimental/_pymodule.h'],
                                  )
-- 
2.51.0

